# ===== MAIN SETTINGS =====
# DEBUG also selects the settings module: 1 -> development, 0 -> production.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://localhost:3000
CORS_ALLOW_CREDENTIALS=True
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO

# Public base URL of this service; used to build links sent by email.
BASE_URL=http://127.0.0.1:8000
BASE_URL_LINK=http://127.0.0.1:8000/api/v1/auth/register/confirmations/

# ===== DATABASE =====
# sqlite  -> zero setup, writes src/db.sqlite3. Good for local development.
# psql    -> PostgreSQL. Requires a running server; the POSTGRES_* values
#            below must be correct or `manage.py migrate` fails with
#            "connection to server at localhost (127.0.0.1), port 5432 failed".
# Docker compose sets DB_TYPE=psql itself, so leave this as sqlite unless you
# are running PostgreSQL directly on your machine.
DB_TYPE=sqlite
POSTGRES_DB=stroyopttorg
POSTGRES_USER=stroyopttorg
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# ===== REDIS (cache + Celery broker) =====
# Either set REDIS_URL, or the individual parts below.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_KEY_PREFIX=stroyopttorg
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=3600

# ===== CELERY =====
# Default to REDIS_URL when left empty.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_SOFT_TIME_LIMIT=60
CELERY_TASK_TIME_LIMIT=120
# Run tasks inline instead of dispatching them (useful for tests).
CELERY_TASK_ALWAYS_EAGER=False

# ===== EMAIL =====
# EMAIL_HOST is the SMTP server. Leave EMAIL_BACKEND empty in development to
# print messages to the console when no SMTP credentials are configured.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@localhost
EMAIL_TIMEOUT=10

# ===== JWT =====
# Access lifetime in minutes, refresh lifetime in days.
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# ===== ONE-TIME CODES =====
OTP_CODE_TTL_MINUTES=3
OTP_MAX_ATTEMPTS=6
OTP_RESEND_COOLDOWN_SECONDS=60

# ===== API =====
PAGE_SIZE=20
THROTTLE_ANON=300/hour
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/hour
THROTTLE_REGISTER=10/hour
THROTTLE_OTP=5/hour
THROTTLE_PASSWORD_RESET=5/hour

# ===== PRODUCTION SECURITY =====
# Set to False when running behind a proxy that does not terminate TLS yet.
SECURE_SSL_ENABLED=True
SECURE_HSTS_SECONDS=31536000

# ===== TELEGRAM BOT =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_CHANNEL_ID=

# ===== FINTECHHUB PAYMENT GATEWAY =====
# merchant_* sign outbound Merchant API calls; service_* validates inbound
# prepare/complete callbacks. Obtain both from the merchant cabinet.
FINTECHHUB_BASE_URL=http://159.223.145.49:3077
FINTECHHUB_MERCHANT_USER_ID=
FINTECHHUB_MERCHANT_SECRET_KEY=
FINTECHHUB_SERVICE_ID=1
FINTECHHUB_SERVICE_SECRET_KEY=
FINTECHHUB_RETURN_URL=http://127.0.0.1:8000/orders/
FINTECHHUB_TIMEOUT=15
FINTECHHUB_VERIFY_SIGNATURE=True
# Card tokenization accepts raw card numbers and puts this deployment in
# PCI-DSS scope. Leave False to use only the hosted /payments/init/ flow.
FINTECHHUB_ENABLE_CARD_TOKENIZATION=False
