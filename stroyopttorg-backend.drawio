027" value="Сознательно отсутствует Elasticsearch. На 50 000 SKU Postgres GIN + pg_trgm и материализованные вьюхи фасетов закрывают поиск с запасом. Выделенный движок — только при подтверждённой деградации p95, иначе это лишняя система в проде и постоянная синхронизация индекса." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=none;strokeColor=#b3b3b3;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="540" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Order status" id="Order-status"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="id8001" value="new&lt;br&gt;&lt;i&gt;заказ создан&lt;/i&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="190" height="50" as="geometry"/></mxCell><mxCell id="id8002" value="awaiting_payment&lt;br&gt;&lt;i&gt;ждём шлюз&lt;/i&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="190" height="50" as="geometry"/></mxCell><mxCell id="id8003" value="processing&lt;br&gt;&lt;i&gt;«Обработка» — из макета&lt;/i&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="190" height="50" as="geometry"/></mxCell><mxCell id="id8004" value="assembled&lt;br&gt;&lt;i&gt;собран&lt;/i&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="190" height="50" as="geometry"/></mxCell><mxCell id="id8005" value="shipp