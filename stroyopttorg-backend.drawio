1" parent="1" source="id500" target="id509"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="id772" value="" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;strokeColor=#8c8c8c;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="id500" target="id344"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="id773" value="" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;strokeColor=#8c8c8c;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="id526" target="id509"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="id774" value="" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;strokeColor=#8c8c8c;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="id127" target="id601"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="id775" value="" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;strokeColor=#8c8c8c;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="id344" target="id572"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="id776" value="" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=10;strokeColor=#8c8c8c;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1" source="id85" target="id659"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="id777" value="Отличия от присланного варианта — и почему:
• ATTRIBUTE / PRODUCT_ATTRIBUTE — без них фильтр «Мощность, Вт»
  и «Тип товара» в категории на 3 457 товаров построить нельзя
• session_key в CART и COMPARE — оформление заказа доступно гостю
• snapshot-поля в ORDER / ORDER_ITEM — заказ не должен меняться
  при следующем импорте цен
• PROMO_CODE + DISCOUNT_TIER — обе механики есть на экране корзины
• STOCK отдельной таблицей — остаток переписывается каждые 15 мин
• REVIEW без product_id — в макете отзывы о магазине, не о товаре
• CART без total_price — итог считается, а не хранится" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=none;strokeColor=#b3b3b3;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="250" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Architecture" id="Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="id5001" value="Браузер / SPA · SSR&lt;br&gt;&lt;i&gt;desktop · tablet · mobile&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="240" height="60" as="geometry"/></mxCell><mxCell id="id5002" value="Nginx&lt;br&gt;&lt;i&gt;TLS, статика, rate limit&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="240" height="60" as="geometry"/></mxCell><mxCell id="id5003" value="&lt;b&gt;Django + DRF&lt;/b&gt;&lt;br&gt;Gunicorn / Uvicorn&lt;br&gt;&lt;i&gt;REST /api/v1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="240" height="80" as="geometry"/></mxCell><mxCell id="id5004" value="Django Admin&lt;br&gt;&lt;i&gt;контент · заказы · лиды&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="240" height="60" as="geometry"/></mxCell><mxCell id="id5005" value="&lt;b&gt;Celery worker + beat&lt;/b&gt;&lt;br&gt;&lt;i&gt;импорт · письма · sitemap&lt;br&gt;пересчёт фасетов&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor